# Mini App
VITE_API_BASE_URL=/api
VITE_APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
APP_ORIGIN=http://localhost:5173
# Standalone public info hub (apps/info) origin — gets browser CORS on
# POST /v1/public/feedback and passes the state-change origin gate.
# E.g. https://kidan-staging-info.vercel.app (leave empty when undeployed).
INFO_ORIGIN=
DATABASE_URL=postgresql://kidan_dev:kidan_dev_only@127.0.0.1:5432/kidan
TELEGRAM_BOT_TOKEN=
# Generate independent 32-byte base64 values; never reuse between purposes.
SESSION_SECRET=
IDENTITY_ENCRYPTION_KEY=
IDENTITY_LOOKUP_KEY=
ENABLE_REAL_SUBMISSIONS=false
# B5: bearer secret for the nightly photo-purge job (same value as Vercel CRON_SECRET).
RETENTION_CRON_SECRET=
# Kidan Completion: bearer secret for the daily journey-scheduler tick at
# /internal/completion/tick (06:00 UTC). Same value as Vercel CRON_SECRET —
# Vercel cron includes it as `Authorization: Bearer` automatically. Without
# this the readiness pulses/stall checks are computed but never run.
COMPLETION_CRON_SECRET=
# B3: operator password for the admin review console; enables /v1/admin/*.
ADMIN_CONSOLE_PASSWORD=
# B4: Mini App URL used to deep-link privacy-safe Telegram notifications (shared by API + bot).
MINI_APP_URL=http://localhost:5173
# Standalone public info hub base URL (bot service): adds "How it works / Rules /
# Privacy notice / FAQ / Report a concern" URL buttons to every menu keyboard.
# E.g. https://kidan-staging-info.vercel.app (leave empty until apps/info is deployed).
INFO_BASE_URL=

# Bot

# Never place real secrets in this file.
